# Example environment variables for Api_rowboat
ENV=development
API_ROWBOAT_HOST=127.0.0.1
API_ROWBOAT_PORT=8000

# Provider selection: ffmpeg, whisper, huggingface
DEFAULT_AUDIO_PROVIDER=whisper
DEFAULT_IMAGE_PROVIDER=huggingface
DEFAULT_VIDEO_PROVIDER=ffmpeg

# Hugging Face Inference (optional)
HF_API_URL=https://api-inference.huggingface.co
HF_API_TOKEN=

# Paths
UPLOAD_DIR=uploads

# ─────────────────────────────────────────────
# ComfyUI (local instance)
# ─────────────────────────────────────────────
COMFYUI_ENABLED=true
COMFYUI_BASE_URL=http://127.0.0.1:8188
COMFYUI_WS_URL=ws://127.0.0.1:8188/ws
COMFYUI_DEFAULT_WORKFLOW_IMAGE_GENERATE=image-generate-v1
COMFYUI_DEFAULT_WORKFLOW_IMAGE_EDIT=image-edit-v1
COMFYUI_DEFAULT_WORKFLOW_IMAGE_INPAINT=image-inpaint-v1
COMFYUI_DEFAULT_WORKFLOW_IMAGE_UPSCALE=image-upscale-v1
COMFYUI_DEFAULT_WORKFLOW_IMAGE_FACE_SWAP=image-face-swap-v1

# ─────────────────────────────────────────────
# Replicate
# ─────────────────────────────────────────────
REPLICATE_ENABLED=true
REPLICATE_API_TOKEN=
REPLICATE_DEFAULT_MODEL_IMAGE_GENERATE=
REPLICATE_DEFAULT_MODEL_IMAGE_EDIT=
REPLICATE_DEFAULT_MODEL_IMAGE_INPAINT=
REPLICATE_DEFAULT_MODEL_IMAGE_UPSCALE=
REPLICATE_DEFAULT_MODEL_VIDEO_PROCESS=
REPLICATE_DEFAULT_MODEL_VIDEO_GENERATE=
REPLICATE_DEFAULT_MODEL_VIDEO_LIP_SYNC=
REPLICATE_DEFAULT_MODEL_AUDIO_TTS=
REPLICATE_DEFAULT_MODEL_AUDIO_STT=
REPLICATE_DEFAULT_MODEL_AUDIO_ENHANCE=
